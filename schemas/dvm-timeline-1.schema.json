{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DVM authoring timeline, version 1 (draft, unofficial)",
  "description": "Application-level authoring input for the DVM tools. NOT a file format and not part of any standard. Structural checks only: contiguity, bounds (x+width <= canvas width, etc.), first event at 0 and transition_duration <= duration are enforced by the reader (src/dvm/timeline.py), because JSON Schema cannot express them.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "canvas", "events"],
  "properties": {
    "version": { "const": 1 },
    "description": { "type": "string" },
    "canvas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "height": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/event" }
    }
  },
  "$defs": {
    "timeString": {
      "type": "string",
      "pattern": "^([0-9]+(\\.[0-9]+)?|[0-9]+/[0-9]+)$"
    },
    "nonNegativeTime": {
      "oneOf": [
        { "type": "number", "minimum": 0 },
        { "$ref": "#/$defs/timeString" }
      ]
    },
    "positiveTime": {
      "oneOf": [
        { "type": "number", "exclusiveMinimum": 0 },
        { "$ref": "#/$defs/timeString" }
      ]
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "duration", "viewport"],
      "properties": {
        "start": { "$ref": "#/$defs/nonNegativeTime" },
        "duration": { "$ref": "#/$defs/positiveTime" },
        "viewport": {
          "type": "object",
          "additionalProperties": false,
          "required": ["x", "y", "width", "height"],
          "properties": {
            "x": { "type": "integer", "minimum": 0, "maximum": 65535 },
            "y": { "type": "integer", "minimum": 0, "maximum": 65535 },
            "width": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "height": { "type": "integer", "minimum": 1, "maximum": 65535 }
          }
        },
        "transition": { "enum": ["cut", "smooth"] },
        "transition_duration": { "$ref": "#/$defs/positiveTime" }
      }
    }
  }
}
